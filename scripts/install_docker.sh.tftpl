#!/bin/bash
# Aprovisionamiento base: swap + Docker. El código se despliega después con scripts/deploy.sh.
exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1
set -euxo pipefail

# Swap de respaldo para los picos de memoria al construir imágenes
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io docker-compose-v2 rsync
systemctl enable --now docker
usermod -aG docker ubuntu

echo "ROLE=${role}" > /etc/warehouse-role
echo "=== Aprovisionamiento completado (${role}) ==="
