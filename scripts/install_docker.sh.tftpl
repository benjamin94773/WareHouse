#!/bin/bash
exec > >(tee /var/log/user-data.log|logger -t user-data -s 2>/dev/console) 2>&1

echo "============================================="
echo "=== INICIANDO PROVISIONAMIENTO DE BODEGA ==="
echo "============================================="

# 0. Configurar 2GB de Swap (Crucial para instancias t3.micro con 1GB de RAM)
if [ ! -f /swapfile ]; then
    echo "=== Configurando 2GB de memoria Swap ==="
    fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
fi

# Detectar gestor de paquetes (Ubuntu vs Amazon Linux)
if command -v apt-get >/dev/null 2>&1; then
    echo "=== Sistema detectado: Ubuntu / Debian ==="
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y docker.io docker-compose-v2 git curl
    systemctl enable --now docker
    TARGET_USER="ubuntu"
    [ -d "/home/ec2-user" ] && TARGET_USER="ec2-user"
elif command -v dnf >/dev/null 2>&1; then
    echo "=== Sistema detectado: Amazon Linux / RHEL ==="
    dnf update -y
    dnf install -y docker git curl
    systemctl enable --now docker
    TARGET_USER="ec2-user"
fi

# 1. Configurar permisos de Docker para el usuario
if [ -n "$TARGET_USER" ] && id "$TARGET_USER" >/dev/null 2>&1; then
    usermod -aG docker "$TARGET_USER" || true
fi

# 2. Asegurar que docker-compose esté disponible
mkdir -p /usr/local/lib/docker/cli-plugins
if [ ! -f /usr/local/lib/docker/cli-plugins/docker-compose ]; then
    curl -SL https://github.com/docker/compose/releases/download/v2.24.5/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose
    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
    ln -sf /usr/local/lib/docker/cli-plugins/docker-compose /usr/bin/docker-compose || true
fi

# 3. Clonado del repositorio de la aplicación
REPO="${repo_url}"
APP_DIR="/home/$TARGET_USER/app"
if [ -n "$REPO" ] && [ -n "$TARGET_USER" ]; then
    echo "=== CLONANDO REPOSITORIO DE BODEGA: $REPO ==="
    mkdir -p "$APP_DIR"
    git clone "$REPO" "$APP_DIR" || (cd "$APP_DIR" && git pull)
    chown -R "$TARGET_USER:$TARGET_USER" "$APP_DIR"

    # 4. Iniciar automáticamente la aplicación con Docker Compose
    if [ -d "$APP_DIR/app" ]; then
        echo "=== INICIANDO CONTENEDORES CON DOCKER COMPOSE ==="
        cd "$APP_DIR/app"
        
        # Iniciar Docker si no estuviera corriendo
        systemctl start docker || true
        
        # Ejecutar docker compose en segundo plano construyendo imágenes
        if docker compose version >/dev/null 2>&1; then
            docker compose up -d --build
        else
            docker-compose up -d --build
        fi
        
        # Asegurar permisos para el usuario
        chown -R "$TARGET_USER:$TARGET_USER" "$APP_DIR" || true
        echo "=== CONTENEDORES INICIADOS Y DISPONIBLES EXITOSAMENTE ==="
    fi
fi

echo "============================================="
echo "=== PROVISIONAMIENTO COMPLETADO CON ÉXITO ==="
echo "============================================="
