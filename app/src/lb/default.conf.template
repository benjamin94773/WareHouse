# Load balancer de la bodega: reparte /api/* entre las réplicas de la API y sirve el frontend.
# Docker resuelve "api" a la IP de cada réplica, y Nginx las usa en round-robin.
upstream api_pool {
    server ${API_TARGET} max_fails=2 fail_timeout=10s;  # health check pasivo
    keepalive 32;
}

server {
    listen 80;

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://api_pool/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Si una réplica cae o devuelve 502/503, el request se reintenta en otra
        proxy_next_upstream error timeout http_502 http_503;
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
        add_header X-Upstream $upstream_addr always;  # muestra qué réplica atendió
    }
}
